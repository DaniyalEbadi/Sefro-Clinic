# Copy this file to .env and fill in your own values:
#   cp .env.example .env    (Windows: copy .env.example .env)
# Without .env the app will refuse to start (secrets have no insecure defaults).
# NEVER commit the real .env file.

DJANGO_SECRET_KEY=

# Set to True ONLY for local development.
DJANGO_DEBUG=False

# Your server's domain(s) or IP(s), comma-separated. Required on the host,
# e.g. DJANGO_ALLOWED_HOSTS=clinic.example.com,www.clinic.example.com
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Production (HTTPS in front of the app): set both to True.
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_JWT_COOKIE_SECURE=False

# Frontend origins allowed to call the API, comma-separated, e.g.
# CORS_ALLOWED_ORIGINS=https://clinic.example.com
CORS_ALLOWED_ORIGINS=
# Leave empty. Only enable if some dev tool needs blanket access.
CORS_ALLOW_ALL_ORIGINS=False
CSRF_TRUSTED_ORIGINS=

# API docs (/api/docs/): False = require login; True = public.
DJANGO_DOCS_PUBLIC=False

# Login/refresh attempts allowed per IP per minute.
THROTTLE_AUTH_RATE=10/min

POSTGRES_DB=sefro_clinic
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Bootstrap account for the API (created once on first migrate).
CLINIC_ADMIN_USERNAME=
CLINIC_ADMIN_PASSWORD=

# Exchange-rate provider (USD→TOMAN) for derived pricing display.
# database = use latest DB row + FINANCE_DEFAULT_USD_TO_TOMAN_RATE fallback
# external = fetch via HTTP + cache to DB; falls back to DB on failure.
# Tindex docs: https://tindex.app/en/developers/  -> GET /api/public/indicators/Foreign-Currency/USD-EXCHANGE-RATE
# Rate limit on free plan: 1 req/min, 100/day; cache TTL keeps you inside limits.
EXCHANGE_RATE_PROVIDER=database
EXCHANGE_RATE_API_URL=https://tindex.app/api/public/indicators/Foreign-Currency/USD-EXCHANGE-RATE
EXCHANGE_RATE_API_KEY=
EXCHANGE_RATE_TIMEOUT=5
EXCHANGE_RATE_CACHE_TTL=3600

# Backup exchange-rate provider (BrsApi.ir) - used if primary fails
EXCHANGE_RATE_BACKUP_API_URL=https://Api.BrsApi.ir/Market/Gold_Currency.php
EXCHANGE_RATE_BACKUP_API_KEY=

# JWT hardening (prod defaults: short access, cookie-only, HTTPS)
JWT_ACCESS_TOKEN_LIFETIME=900            # 15 min (seconds)
JWT_REFRESH_TOKEN_LIFETIME=604800        # 7 days (seconds)
DJANGO_JWT_COOKIE_SECURE=False           # True in prod behind HTTPS
DJANGO_RETURN_TOKENS_IN_BODY=False       # False in prod (cookie-only), True for dev/Swagger
